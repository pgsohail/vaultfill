{
  "name": "vaultfill",
  "description": "Zero-knowledge, framework-proof password autofill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:test-pages && wxt build && playwright test",
    "serve:test-pages": "node scripts/serve-test-pages.mjs",
    "postinstall": "wxt prepare",
    "build:test-pages": "node scripts/build-test-pages.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.4.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
